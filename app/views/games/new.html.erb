<div class="ck-page overflow-hidden">
  <section class="relative mb-8 rounded-[10px] border-[0.5px] border-ck-line bg-ck-card p-5  sm:p-8 lg:p-10">
    <div class="relative">
      <div class="ck-sticker mb-5">Games</div>
      <h1 class="ck-heading max-w-5xl">Challenge a friend</h1>
    </div>
  </section>

  <section class="grid grid-cols-1 gap-6 xl:grid-cols-[minmax(0,520px)_minmax(0,1fr)]">
    <div class="ck-card ck-card--quiet bg-ck-card">
      <form action="<%= games_path %>" method="post" class="space-y-6">
        <%= hidden_field_tag :authenticity_token, form_authenticity_token %>

        <% if flash[:alert] %>
          <div class="border-[0.5px] border-ck-line bg-ck-card p-4 text-lg font-semibold  ">
            <%= flash[:alert] %>
          </div>
        <% end %>

        <div>
          <label for="opponent_id" class="ck-meta mb-3 block">Opponent</label>
          <% if @friends.any? %>
            <select id="opponent_id" name="opponent_id" class="ck-input">
              <% @friends.each do |friend| %>
                <option value="<%= friend.id %>"><%= friend.full_name %></option>
              <% end %>
            </select>
          <% else %>
            <div class="border-[0.5px] border-ck-line bg-ck-raised p-4 ">
              <p class="mb-4 text-lg font-semibold  leading-snug">No friends yet. Send Invitations before starting a Game.</p>
              <%= link_to "Send Invitations", invitations_path, class: "ck-btn-primary" %>
            </div>
          <% end %>
        </div>

        <div>
          <div class="ck-meta mb-3">Rounds</div>
          <div class="grid grid-cols-1 gap-3 sm:grid-cols-3">
            <% [["1 Round", "one"], ["3 Rounds", "three"], ["5 Rounds", "five"]].each do |label, val| %>
              <label class="cursor-pointer">
                <input type="radio" name="round_count" value="<%= val %>" class="peer sr-only" <%= "checked" if val == "one" %>>
                <span class="flex min-h-14 items-center justify-center border-[0.5px] border-ck-line bg-ck-card px-3 py-3 text-center text-sm font-semibold   transition-transform duration-100 peer-checked:translate-x-1 peer-checked:translate-y-1 peer-checked:bg-ck-raised peer-checked:shadow-none">
                  <%= label %>
                </span>
              </label>
            <% end %>
          </div>
        </div>

        <div>
          <div class="ck-meta mb-3">Difficulty</div>
          <div class="grid grid-cols-1 gap-3 sm:grid-cols-3">
            <% [["Easy", "easy"], ["Medium", "medium"], ["Hard", "hard"]].each do |label, val| %>
              <label class="cursor-pointer">
                <input type="radio" name="difficulty" value="<%= val %>" class="peer sr-only" <%= "checked" if val == "easy" %>>
                <span class="flex min-h-14 items-center justify-center border-[0.5px] border-ck-line bg-ck-card px-3 py-3 text-center text-sm font-semibold   transition-transform duration-100 peer-checked:translate-x-1 peer-checked:translate-y-1 peer-checked:shadow-none <%= val == 'easy' ? 'peer-checked:bg-ck-raised' : val == 'medium' ? 'peer-checked:bg-ck-raised' : 'peer-checked:bg-ck-card' %>">
                  <%= label %>
                </span>
              </label>
            <% end %>
          </div>
        </div>

        <% if @friends.any? %>
          <button type="submit" class="ck-btn-primary w-full">Send Challenge</button>
        <% end %>
      </form>
    </div>

    <aside class="ck-card bg-ck-raised">
      <div class="ck-meta mb-4">Game rules</div>
      <div class="space-y-4 text-2xl font-semibold  leading-none">
        <p class="border-[0.5px] border-ck-line bg-ck-card p-4 ">Pick a friend.</p>
        <p class="border-[0.5px] border-ck-line bg-ck-raised p-4 ">Choose 1, 3, or 5 Rounds.</p>
        <p class="border-[0.5px] border-ck-line bg-ck-card p-4 ">First to pass the tests wins the Round.</p>
      </div>
    </aside>
  </section>
</div>
