<% opp = @game.opponent == current_user ? @game.challenger : @game.opponent %>

<% if @game.pending? %>
  <div
    id="game-lobby"
    data-controller="game"
    data-game-game-id-value="<%= @game.id %>"
    data-game-current-user-id-value="<%= current_user.id %>"
    class="ck-page"
  >
    <section class="mb-8 border-[0.5px] border-ck-line bg-ck-raised p-5  sm:p-8 lg:p-10">
      <div class="ck-sticker mb-5">Game / Pending</div>
      <h1 class="ck-heading">Waiting room</h1>
    </section>

    <section class="ck-card ck-card--quiet max-w-3xl bg-ck-card">
      <div class="mb-6 grid grid-cols-1 gap-4 sm:grid-cols-[1fr_auto_1fr] sm:items-center">
        <% [[@game.challenger, "Challenger", "bg-ck-card"], [@game.opponent, "Opponent", "bg-ck-raised"]].each do |player, role, color_class| %>
          <div class="border-[0.5px] border-ck-line <%= color_class %> p-4 ">
            <div class="mb-3 flex h-14 w-14 items-center justify-center rounded-full border-[0.5px] border-ck-line bg-ck-card text-lg font-semibold"><%= player.initials %></div>
            <div class="text-2xl font-semibold  leading-none"><%= player.full_name %></div>
            <div class="ck-meta mt-2"><%= role %></div>
          </div>
          <% if role == "Challenger" %>
            <div class="justify-self-center border-[0.5px] border-ck-line bg-ck-ink px-4 py-3 text-xl font-semibold  text-white ">vs</div>
          <% end %>
        <% end %>
      </div>

      <div class="mb-6 flex flex-wrap gap-3">
        <span class="ck-chip"><%= Game::ROUND_COUNT_NUM[@game.round_count] %> rounds</span>
        <span class="ck-chip ck-chip--<%= @game.difficulty %>"><%= @game.difficulty.capitalize %></span>
      </div>

      <% if @game.opponent == current_user %>
        <div class="grid grid-cols-1 gap-3 sm:grid-cols-2">
          <%= button_to "Accept Game", accept_game_path(@game), method: :post, class: "ck-btn-primary w-full" %>
          <%= button_to "Decline", decline_game_path(@game), method: :post, class: "ck-btn-outline w-full",
              data: { confirm: "Are you sure you want to decline?" } %>
        </div>
      <% else %>
        <div class="flex items-center gap-3 border-[0.5px] border-ck-line bg-ck-raised p-4 text-lg font-semibold  ">
          <svg class="h-6 w-6 animate-spin" viewBox="0 0 24 24" fill="none">
            <circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"/>
            <path fill="currentColor" d="M4 12a8 8 0 018-8v8H4z"/>
          </svg>
          Waiting for <%= @game.opponent.first_name %> to accept
        </div>
      <% end %>
    </section>
  </div>

<% elsif @game.completed? %>
  <div class="ck-page">
    <section class="mb-8 border-[0.5px] border-ck-line bg-ck-card p-5  sm:p-8 lg:p-10">
      <div class="ck-sticker mb-5">Game / Completed</div>
      <h1 class="ck-heading">Results</h1>
    </section>

    <div class="grid grid-cols-1 gap-6 xl:grid-cols-[minmax(0,520px)_minmax(0,1fr)]">
      <section class="ck-card ck-card--quiet bg-ck-card text-center">
        <% if @game.winner == current_user %>
          <div class="mb-4 text-6xl font-semibold">WIN</div>
          <div class="mb-2 text-3xl font-semibold  leading-none">You won</div>
          <div class="ck-meta">Beat <%= opp.first_name %></div>
        <% else %>
          <div class="mb-4 text-6xl font-semibold">LOSS</div>
          <div class="mb-2 text-3xl font-semibold  leading-none"><%= @game.winner.full_name %> won</div>
          <div class="ck-meta">Run it back.</div>
        <% end %>

        <% deltas = @game.score_deltas %>
        <% if deltas.present? %>
          <div class="mt-6 grid grid-cols-2 gap-4 border-t-[0.5px] border-ck-line pt-5">
            <% [@game.challenger, @game.opponent].each do |player| %>
              <div class="border-[0.5px] border-ck-line bg-ck-raised p-4 ">
                <div class="ck-meta mb-2"><%= player == current_user ? "You" : player.first_name %></div>
                <div class="text-3xl font-semibold tabular-nums">
                  <%= deltas[:winner_id] == player.id ? "+#{deltas[:winner_delta]}" : "+#{deltas[:loser_delta]}" %>
                </div>
              </div>
            <% end %>
          </div>
        <% end %>
      </section>

      <section class="ck-card ck-card--quiet bg-ck-raised">
        <div class="ck-meta mb-4">Round Summary</div>
        <div class="space-y-4">
          <% @rounds.each do |round| %>
            <div class="flex flex-col gap-3 border-[0.5px] border-ck-line bg-ck-card p-4  sm:flex-row sm:items-center sm:justify-between">
              <div>
                <div class="text-xl font-semibold  leading-none">Round <%= round.round_number %> / <%= round.challenge.name %></div>
                <div class="ck-meta mt-2"><%= round.challenge.difficulty.capitalize %></div>
              </div>
              <% if round.round_winner %>
                <span class="ck-chip <%= round.round_winner == current_user ? 'ck-chip--completed' : '' %>">
                  <%= round.round_winner == current_user ? "You" : round.round_winner.first_name %>
                </span>
              <% else %>
                <span class="ck-chip ck-chip--outline">Open</span>
              <% end %>
            </div>
          <% end %>
        </div>
        <div class="mt-6">
          <%= link_to "Back to Home", root_path, class: "ck-btn-outline" %>
        </div>
      </section>
    </div>
  </div>

<% else %>
  <div
    id="game-room"
    data-controller="game"
    data-game-game-id-value="<%= @game.id %>"
    data-game-current-user-id-value="<%= current_user.id %>"
    data-game-challenge-id-value="<%= @current_round&.challenge&.id %>"
    data-game-round-id-value="<%= @current_round&.id %>"
    class="ck-page space-y-6"
  >
    <div id="game-banner" class="ck-card hidden bg-ck-card text-center text-2xl font-semibold "></div>

    <section class="ck-card ck-card--quiet bg-ck-raised">
      <div class="flex flex-col gap-5 lg:flex-row lg:items-center lg:justify-between">
        <div>
          <div class="ck-meta mb-2">Round <span id="current-round-number"><%= @current_round&.round_number || @rounds.size %></span> of <%= Game::ROUND_COUNT_NUM[@game.round_count] %></div>
          <h1 class="text-4xl font-semibold  leading-none"><%= @current_round&.challenge&.name %></h1>
        </div>
        <div class="grid grid-cols-[1fr_auto_1fr] items-center gap-3 text-center">
          <div class="border-[0.5px] border-ck-line bg-ck-card p-3 ">
            <div class="ck-meta mb-1">You</div>
            <div class="text-4xl font-semibold tabular-nums" data-game-target="myScore"><%= @rounds.count { |r| r.round_winner == current_user } %></div>
            <span id="user_status_<%= current_user.id %>"><%= render partial: 'users/status', locals: { status: 'Active' } %></span>
          </div>
          <div class="font-semibold ">vs</div>
          <div class="border-[0.5px] border-ck-line bg-ck-raised p-3 ">
            <div class="ck-meta mb-1"><%= opp.first_name %></div>
            <div class="text-4xl font-semibold tabular-nums" data-game-target="opponentScore"><%= @rounds.count { |r| r.round_winner == opp } %></div>
            <span id="user_status_<%= opp.id %>"><%= render partial: 'users/status', locals: { status: 'Inactive' } %></span>
          </div>
        </div>
      </div>
    </section>

    <% if @current_round %>
      <div class="grid grid-cols-1 gap-6 xl:grid-cols-[minmax(0,0.8fr)_minmax(0,1.2fr)]">
        <aside class="space-y-6">
          <section class="ck-card ck-card--quiet bg-ck-card">
            <div class="ck-meta mb-3">Challenge Description</div>
            <div class="whitespace-pre-line text-lg font-bold leading-relaxed text-ck-ink"><%= @current_round.challenge.description %></div>
          </section>

          <section class="ck-card ck-card--quiet bg-ck-raised">
            <div class="ck-meta mb-3">Test Cases</div>
            <div class="overflow-auto border-[0.5px] border-ck-line bg-ck-card p-4 font-mono text-sm font-bold leading-relaxed ">
              <% if @current_round.challenge.tests.present? %>
                <%= @current_round.challenge.parsed_tests.map.with_index { |t, i| "Test #{i + 1}: #{t}" }.join("\n") %>
              <% else %>
                No test cases available.
              <% end %>
            </div>
          </section>

          <section class="ck-card ck-card--quiet bg-ck-raised">
            <div class="ck-meta mb-3">Test Results</div>
            <pre class="min-h-[120px] overflow-auto border-[0.5px] border-ck-line bg-ck-card p-4 font-mono text-sm font-bold leading-relaxed " data-game-target="output">Run your code to see results.</pre>
          </section>
        </aside>

        <section class="space-y-6">
          <div id="code-editor" data-method-template="<%= @current_round.challenge.method_template %>" class="ck-card ck-card--quiet bg-ck-card">
            <div class="mb-4 flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
              <div>
                <div class="ck-meta mb-2">Your Code</div>
                <h2 class="text-3xl font-semibold  leading-none">Ruby editor</h2>
              </div>
              <div class="flex flex-col gap-2 sm:flex-row">
                <% if AppSetting.ai_hints_enabled? %>
                  <button data-action="click->game#hint" class="ck-btn-outline">Hint</button>
                <% end %>
                <button data-action="click->game#run" data-game-target="runBtn" class="ck-btn-primary">Run Tests</button>
              </div>
            </div>
            <textarea class="hidden" data-game-target="editor"></textarea>
          </div>

          <div class="ck-card ck-card--quiet bg-ck-raised">
            <div class="mb-4 flex items-center justify-between gap-3">
              <div>
                <div class="ck-meta mb-2"><%= opp.first_name %>'s Code</div>
                <h2 class="text-2xl font-semibold  leading-none">Read only</h2>
              </div>
              <span class="ck-chip ck-chip--outline">Opponent</span>
            </div>
            <textarea class="hidden" data-game-target="opponentEditor"></textarea>
            <div class="mt-4 border-[0.5px] border-ck-line bg-ck-card p-3 text-sm font-semibold  " data-game-target="opponentStatus">
              Waiting for <%= opp.first_name %> to start coding
            </div>
          </div>
        </section>
      </div>
    <% else %>
      <div class="ck-card bg-ck-raised py-8 text-center text-2xl font-semibold ">All rounds complete.</div>
    <% end %>
  </div>
<% end %>
