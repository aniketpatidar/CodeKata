<div class="ck-page">
  <section class="mb-8 border-[0.5px] border-ck-line bg-ck-raised p-5  sm:p-8 lg:p-10">
    <div class="ck-sticker mb-5">Posts</div>
    <h1 class="ck-heading">Edit Post</h1>
  </section>

  <div class="ck-card max-w-2xl">
    <%= render "form", post: @post %>
  </div>

  <div class="mt-6 flex gap-4">
    <%= link_to "← Show this Post", @post, class: "ck-btn-outline" %>
    <%= link_to "Back to Posts", posts_path, class: "ck-btn-outline" %>
  </div>
</div>