<div class="ck-page overflow-hidden">
  <section class="relative mb-8 rounded-[10px] border-[0.5px] border-ck-line bg-ck-raised p-5  sm:p-8 lg:p-10">
    <div class="relative">
      <div class="ck-sticker mb-5">Post</div>
      <h1 class="ck-heading max-w-5xl"><%= @post.title %></h1>
    </div>
  </section>

  <% if notice.present? %>
    <div class="ck-card bg-ck-raised mb-6 flex items-center gap-3">
      <svg class="h-5 w-5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="4" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
      </svg>
      <p class="text-sm font-semibold "><%= notice %></p>
    </div>
  <% end %>

  <div class="ck-card bg-ck-card mb-8">
    <div class="prose prose-lg max-w-none font-bold text-ck-ink">
      <%= @post.body %>
    </div>
  </div>

  <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
    <a href="/<%= @post.user.slug %>" class="ck-card flex items-center gap-3 bg-ck-raised" style="text-decoration: none;">
      <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full border-[0.5px] border-ck-line bg-ck-card text-sm font-semibold">
        <% if @post.user.avatar.attached? %>
          <%= image_tag @post.user.avatar, class: "h-full w-full rounded-full object-cover" %>
        <% else %>
          <%= @post.user.initials %>
        <% end %>
      </div>
      <div>
        <div class="text-base font-semibold  leading-none text-ck-ink"><%= @post.user.full_name %></div>
        <div class="ck-meta mt-1">Author</div>
      </div>
    </a>

    <% if current_user == @post.user %>
      <div class="flex gap-3">
        <%= link_to "Edit", edit_post_path(@post), class: "ck-btn-outline" %>
        <%= button_to "Delete", post_path(@post), method: :delete, data: { confirm: "Are you sure?" }, class: "ck-btn-outline", style: "color: #f87171; border-color: rgba(248,113,113,0.3); cursor: pointer;" %>
      </div>
    <% end %>
  </div>

  <div class="mt-6">
    <%= link_to "← Back to Posts", posts_path, class: "ck-btn-outline" %>
  </div>
</div>