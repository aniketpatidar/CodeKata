<div class="ck-page overflow-hidden">
  <section class="relative mb-8 rounded-[10px] border-[0.5px] border-ck-line bg-ck-card p-5  sm:p-8 lg:p-10">
    <div class="relative flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
      <div>
        <div class="ck-sticker mb-5">Archive</div>
        <h1 class="ck-heading max-w-4xl">Posts</h1>
      </div>
      <%= link_to "New Post", new_post_path,
            class: "ck-btn-primary",
            data: { action: "click->slideover#open", remote: true } %>
    </div>
  </section>

  <div id="posts" class="space-y-5">
    <%= render @posts %>
  </div>
</div>