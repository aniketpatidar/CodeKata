<div id="<%= dom_id discussion %>" class="ck-card mb-5 <%= (defined?(index) && index.even?) ? ']' : ']' %>">
  <div class="flex flex-col gap-4 lg:flex-row">
    <%= render "discussions/voting", discussion: discussion %>

    <div class="min-w-0 flex-1">
      <h2 class="text-2xl font-semibold  leading-none mb-3">
        <%= link_to discussion.name, discussion, data: { turbo: false }, class: "text-ck-ink hover:underline" %>
      </h2>
      <p class="text-base font-bold leading-snug text-ck-ink mb-4"><%= discussion.description %></p>

      <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
        <div class="flex flex-wrap gap-2">
          <% discussion.categories.each do |category| %>
            <span class="ck-chip ck-chip--outline text-[10px]"><%= category.name %></span>
          <% end %>
        </div>
        <span class="ck-chip text-[11px]"><%= discussion.posts.count %> Answers</span>
      </div>

      <div class="ck-meta mt-4 flex flex-wrap gap-3 text-[10px]">
        <%= link_to discussion.user.full_name, "/users/#{discussion.user.slug}", class: "text-ck-ink underline" %>
        <span>Asked <%= time_ago_in_words(discussion.created_at) %> ago</span>
      </div>
    </div>
  </div>
</div>