<turbo-frame id="<%= "#{dom_id(post)}_form" %>" target="_top">
  <%= form_with(model: [post.discussion, post], class: "space-y-4") do |form| %>
    <% if post.errors.any? %>
      <div class="ck-card mb-4 bg-ck-card">
        <p class="ck-meta mb-2"><%= pluralize(post.errors.count, "error") %> prevented this from saving</p>
        <ul class="space-y-0.5">
          <% post.errors.each do |error| %>
            <li class="text-sm font-bold text-ck-ink"><%= error.full_message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div>
      <%= form.label :body, class: "ck-meta block mb-2" %>
      <%= form.rich_text_area :body, placeholder: "Reply to this discussion..." %>
    </div>

    <%= form.submit "Post Your Answer", class: "ck-btn-primary" %>
  <% end %>
</turbo-frame>
