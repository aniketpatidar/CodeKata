<turbo-frame id="<%= dom_id(@post) %>">
  <div class="ck-card ck-card--quiet my-4 bg-ck-card">
    <%= render(partial: "discussions/posts/header", locals: { post: @post }) %>
    <div class="mt-4">
      <%= render("form", post: @post) %>
    </div>
    <div class="mt-5">
      <%= link_to "Back", discussion_post_path(@post.discussion, @post), class: "ck-btn-outline" %>
    </div>
  </div>
</turbo-frame>
