<%= form_with(model: discussion, class: "space-y-6") do |form| %>
  <% if discussion.errors.any? %>
    <div class="ck-card bg-ck-card">
      <p class="ck-meta mb-2"><%= pluralize(discussion.errors.count, "error") %> prevented this from saving</p>
      <ul class="space-y-0.5">
        <% discussion.errors.each do |error| %>
          <li class="text-sm font-bold text-ck-ink"><%= error.options[:message] %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :name, class: "ck-meta block mb-1" do %>
      Title
      <span class="ml-2 text-[11px] normal-case tracking-normal">Be specific and imagine you're asking another person.</span>
    <% end %>
    <%= form.text_field :name, class: "ck-input" %>
  </div>

  <div>
    <%= form.label :description, class: "ck-meta block mb-1" do %>
      Details
      <span class="ml-2 text-[11px] normal-case tracking-normal">Expand on what you put in the title. Minimum 20 characters.</span>
    <% end %>
    <%= form.rich_text_area :description %>
  </div>

  <div>
    <%= form.label :categories, class: "ck-meta block mb-1" do %>
      Tags
      <span class="ml-2 text-[11px] normal-case tracking-normal">Add up to 5 tags.</span>
    <% end %>
    <%= form.collection_select :category_ids, Category.order(:name), :id, :name, {},
          { class: "ck-input", multiple: true, "data-controller": "select2" } %>
  </div>

  <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:gap-6">
    <label class="flex items-center gap-2 cursor-pointer">
      <%= form.check_box :pinned, class: "h-6 w-6 border-[0.5px] border-ck-line text-ck-accent" %>
      <span class="text-sm font-semibold  text-ck-ink">Pinned</span>
    </label>
    <label class="flex items-center gap-2 cursor-pointer">
      <%= form.check_box :closed, class: "h-6 w-6 border-[0.5px] border-ck-line text-ck-accent" %>
      <span class="text-sm font-semibold  text-ck-ink">Closed</span>
    </label>
  </div>

  <%= form.submit "Post Your Question", class: "ck-btn-primary" %>
<% end %>
