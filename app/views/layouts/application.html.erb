<!DOCTYPE html>
<html>
  <head>
    <title>CodeKata</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;700&family=JetBrains+Mono:wght@400;500;700&display=block" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.2/codemirror.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.59.4/theme/monokai.min.css">
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.2/codemirror.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.2/mode/ruby/ruby.min.js"></script>
  </head>

  <body class="bg-ck-bg text-ck-ink" data-controller="slideover sidebar">
    <% if current_user %>
      <%= turbo_stream_from "online_users", channel: OnlineChannel %>
    <% end %>
    <header class="lg:hidden fixed top-0 inset-x-0 z-30 h-14 flex items-center justify-between px-4"
            style="background: var(--ck-bg); border-bottom: 0.5px solid var(--ck-line);">
      <span class="font-semibold text-[16px] tracking-tight">CodeKata</span>
      <button type="button" data-action="sidebar#toggle" aria-label="Toggle menu" class="p-2 -mr-2" style="color: var(--ck-ink);">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 6h16M4 12h16M4 18h16"/></svg>
      </button>
    </header>
    <div data-sidebar-target="backdrop" data-action="click->sidebar#close" class="hidden fixed inset-0 z-30 bg-black/60 lg:hidden"></div>
    <%= render "layouts/sidebar" %>
    <div class="min-h-screen pt-14 lg:pt-0 lg:ml-[240px]">
      <div id="flash-container">
        <% flash.each do |key, value| %>
          <%= render "shared/flash", level: key, content: value %>
        <% end %>
      </div>
      <main>
        <%= yield %>
      </main>
    </div>
    <%= render "shared/slideover" %>
  </body>
</html>
