<% end %>
<% if alert %>
  <div class="ck-card mb-4 flex items-center gap-3 text-sm font-semibold  " style="border-color: rgba(248,113,113,0.3);">
    <p style="color: #f87171;"><%= alert %></p>
  </div>
<% end %>