<div class="ck-page overflow-hidden">
  <section class="relative mb-8 rounded-[10px] border-[0.5px] border-ck-line bg-ck-card p-5  sm:p-8 lg:p-10">
    <div class="relative">
      <div class="ck-sticker mb-5">Alerts</div>
      <h1 class="ck-heading max-w-4xl">Notifications</h1>
    </div>
  </section>

  <%= turbo_frame_tag "notifications" do %>
    <% if @notifications.any? %>
      <div class="space-y-3">
        <%= render @notifications %>
      </div>
    <% else %>
      <div class="ck-card bg-ck-raised text-center py-16">
        <div class="text-4xl mb-4 font-semibold">✓</div>
        <p class="text-lg font-semibold  leading-snug">You're all caught up</p>
      </div>
    <% end %>
  <% end %>
</div>