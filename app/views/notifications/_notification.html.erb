<div class="ck-card flex items-start gap-3"
     id="<%= dom_id(notification) %>"
     data-controller="notifications"
     data-public="<%= notification.to_global_id.to_s %>">
  <button data-action="click->notifications#read"
          class="shrink-0 flex items-center justify-center border-[0.5px] border-ck-line bg-ck-card  hover:-translate-x-0.5 hover:-translate-y-0.5 transition-transform"
          style="min-height: 2rem; width: 2rem; padding: 0; cursor: pointer;"
          title="Mark as read">
    <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="4" d="M5 13l4 4L19 7"></path>
    </svg>
    <span class="sr-only">Mark as read</span>
  </button>
  <div class="min-w-0 flex-1">
    <p class="text-sm font-semibold  leading-tight text-ck-ink break-words">
      <%= link_to notification.message,
            notification.url,
            style: "color: inherit; text-decoration: none;",
            data: { id: notification.id, action: "click->slideover#connect", remote: true } %>
    </p>
    <p class="ck-meta mt-1"><%= time_ago_in_words(notification.created_at) %> ago</p>
  </div>
</div>