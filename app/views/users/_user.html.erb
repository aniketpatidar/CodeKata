<a href="/users/<%= user.slug %>"
   id="<%= dom_id(user) %>"
   class="ck-card group block <%= local_assigns[:index] && index.even? ? ']' : ']' %>"
   style="text-decoration: none;">
  <div class="flex items-center gap-4">
    <div class="flex h-14 w-14 shrink-0 items-center justify-center rounded-full border-[0.5px] border-ck-line bg-ck-raised text-base font-semibold">
      <% if user.avatar.attached? %>
        <%= image_tag user.avatar, class: "h-full w-full rounded-full object-cover" %>
      <% else %>
        <%= user.initials %>
      <% end %>
    </div>
    <div class="min-w-0 flex-1">
      <div class="text-lg font-semibold  leading-none text-ck-ink"><%= user.full_name %></div>
      <div class="ck-meta mt-1">@<%= user.slug %></div>
    </div>
    <div class="shrink-0">
      <%= render partial: 'users/status', locals: { status: @active_users.include?(user) ? 'Active' : 'Inactive' } %>
    </div>
  </div>
  <div class="ck-meta mt-3 pt-3" style="border-top: 2px solid var(--ck-line);">
    Joined <%= user.created_at.strftime("%b %d, %Y") %>
  </div>
</a>