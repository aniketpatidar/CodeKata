<div class="ck-page overflow-hidden">
  <section class="relative mb-8 rounded-[10px] border-[0.5px] border-ck-line bg-ck-raised p-5  sm:p-8 lg:p-10">
    <div class="relative grid grid-cols-1 gap-6 xl:grid-cols-[minmax(0,1fr)_420px] xl:items-end">
      <div>
        <div class="ck-sticker mb-5">Community</div>
        <h1 class="ck-heading max-w-4xl">All Users</h1>
      </div>
      <%= form_tag users_path, method: :get, data: { turbo_frame: "search-results", turbo_action: "advance", controller: "search", action: "input->search#submit" } do %>
        <div class="border-[0.5px] border-ck-line bg-ck-card p-4 ">
          <label for="query" class="ck-meta mb-3 block">Search Users</label>
          <div class="flex flex-col gap-3 sm:flex-row">
            <%= text_field_tag "query", nil, placeholder: "Search by name or username...", class: "ck-input min-w-0 flex-1" %>
            <%= submit_tag "Search", class: "ck-btn-outline shrink-0" %>
          </div>
        </div>
      <% end %>
    </div>
  </section>

  <div id="users-list">
    <%= turbo_frame_tag "search-results" do %>
      <% users = @active_users + @inactive_users %>
      <% if users.any? %>
        <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
          <% users.each_with_index do |user, index| %>
            <%= render partial: 'users/user', locals: { user:, index: } %>
          <% end %>
        </div>
        <div class="mt-8">
          <%== pagy_nav(@pagy) %>
        </div>
      <% else %>
        <div class="ck-card bg-ck-raised text-center">
          <div class="ck-meta mb-3">No users found</div>
          <p class="mb-5 text-xl font-semibold  leading-snug">Try another search.</p>
        </div>
      <% end %>
    <% end %>
  </div>
</div>