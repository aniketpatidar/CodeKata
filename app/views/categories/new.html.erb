<div class="ck-page">
  <section class="mb-8 border-[0.5px] border-ck-line bg-ck-raised p-5  sm:p-8 lg:p-10">
    <div class="ck-sticker mb-5">Categories</div>
    <h1 class="ck-heading">New Category</h1>
  </section>

  <div class="ck-card max-w-2xl">
    <%= render "form", category: @category %>
  </div>

  <div class="mt-6">
    <%= link_to "← Back to Categories", categories_path, class: "ck-btn-outline" %>
  </div>
</div>